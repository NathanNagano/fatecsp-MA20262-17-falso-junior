// --- 1. MEDIDAS FUNDAMENTAIS (7 DA ESPECIFICAÇÃO) ---

Faturamento Bruto := 
SUMX ( fVendas, fVendas[Quantidade] * fVendas[Valor_Unit] )

Faturamento := 
SUM ( fVendas[Valor_Liquido] )

Qtd Cupons := 
DISTINCTCOUNT ( fVendas[ID_Cupom] )

Ticket Médio := 
DIVIDE ( [Faturamento], [Qtd Cupons] )

Custo Total := 
SUMX ( fVendas, fVendas[Quantidade] * RELATED ( dProduto[Custo] ) )

Margem Bruta % := 
DIVIDE ( [Faturamento] - [Custo Total], [Faturamento] )

Meta := 
SUM ( fMetas[Meta] )

% Meta := 
DIVIDE ( [Faturamento], SUM ( fMetas[Meta] ) )

// --- 2. MEDIDAS ADICIONAIS E INTELIGÊNCIA DE TEMPO ---

Qtd Itens := 
SUM ( fVendas[Quantidade] )

Itens por Cupom := 
DIVIDE ( [Qtd Itens], [Qtd Cupons] )

Faturamento Frio := 
CALCULATE ( [Faturamento], dProduto[Categoria] = "Frio" )

% Bebidas Frias := 
DIVIDE ( 
    [Faturamento Frio], 
    CALCULATE ( [Faturamento], dProduto[Categoria] IN { "Quente", "Frio" } ) 
)

Faturamento Mes Anterior := 
CALCULATE ( [Faturamento], DATEADD ( dCalendario[Data], -1, MONTH ) )

Cresc. MoM % := 
VAR Atual = [Faturamento]
VAR Anterior = CALCULATE ( [Faturamento], DATEADD ( dCalendario[Data], -1, MONTH ) )
RETURN 
    IF ( NOT ISBLANK ( Atual ), DIVIDE ( Atual - Anterior, Anterior ) )

// --- 3. MEDIDAS DE INTEGRIDADE E CONFERÊNCIA RELACIONAL ---

Conf Linhas fVendas := 
COUNTROWS ( fVendas )

Conf Linhas Rejeitados := 
COUNTROWS ( Rejeitados )

Conf Linhas Lidas := 
[Conf Linhas fVendas] + [Conf Linhas Rejeitados]

Conf Vendas sem Produto := 
COUNTROWS ( FILTER ( fVendas, ISBLANK ( RELATED ( dProduto[Produto] ) ) ) ) + 0

Conf Vendas sem Filial := 
COUNTROWS ( FILTER ( fVendas, ISBLANK ( RELATED ( dFilial[Filial] ) ) ) ) + 0

Conf Vendas sem Data := 
COUNTROWS ( FILTER ( fVendas, ISBLANK ( RELATED ( dCalendario[Mes] ) ) ) ) + 0

Conf Metas sem Mes := 
COUNTROWS ( FILTER ( fMetas, ISBLANK ( RELATED ( dCalendario[Mes] ) ) ) ) + 0

Conf PK Duplicada := 
( COUNTROWS ( dProduto ) - DISTINCTCOUNT ( dProduto[Cod] ) ) +
( COUNTROWS ( dFilial ) - DISTINCTCOUNT ( dFilial[Cod_Filial] ) ) +
( COUNTROWS ( dCalendario ) - DISTINCTCOUNT ( dCalendario[Data] ) )
